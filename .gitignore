.DS_Store
node_modules/
dist/
.astro/
*.log

# Terraform — note .terraform.lock.hcl IS committed, so CI resolves
# the same provider versions that were planned locally
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Partial backend config — the state bucket name embeds the AWS account id,
# and this repository is public
backend.hcl

# Saved plans. A plan file carries resource attributes and account identifiers
# in the clear, whatever the configuration does to keep them out of the repo
tfplan
*.tfplan

# Build artefacts
site/public/audio/
build/

# Large media — belongs in S3, not git history
*.m4a
*.mp3
*.wav
*.pdf

# Python
__pycache__/
*.pyc

# Speech transform output — regenerated from content/
scripts/speech/

# Domain registrant PII — never commit
infra/domain-registration.json

# Primary rulebooks — fetched PDFs and their extracted text.
#
# NOT committed, and the reason is copyright rather than secrecy: these are the
# IIHF's, the NHL's, USA Hockey's and Hockey Canada's publications. This
# repository is public, and 2.7 MB of searchable rulebook text is a clearer
# redistribution than the PDFs `*.pdf` above already excludes. The corpus
# quotes them under fair dealing; republishing them wholesale is a different
# act.
#
# sources/README.md is committed and holds every URL, so any session can
# rebuild this directory. See scripts/fetch_sources.sh.
sources/*
!sources/README.md
site/.print/

# Rendered diagrams. Generated by site/scripts/build-diagrams.mjs from the specs in
# site/src/diagrams/, which are the source. 18 MB of SVG and PNG that a build
# reproduces exactly; committing them would put a derived artefact in the history
# and invite it to drift from the spec that produced it. The manifest
# (site/src/data/diagrams.json) IS committed, because scripts/md_to_speech.py reads
# captions from it outside the site build.
site/public/diagrams/

# JetBrains project files — local IDE state, not project configuration.
.idea/

# A rink SVG supplied for reference early on. Not to scale — the neutral zone is 40%
# of the sheet against a true 25% — and superseded by the generated diagrams, which
# derive from the coordinate table the corpus owns. Kept out of the history rather
# than deleted, because it is not this project's file to delete.
/Icehockeylayout.svg
