.DS_Store
node_modules/
dist/
.astro/
*.log

# Terraform — note .terraform.lock.hcl IS committed, so CI resolves
# the same provider versions that were planned locally
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Partial backend config — the state bucket name embeds the AWS account id,
# and this repository is public
backend.hcl

# Saved plans. A plan file carries resource attributes and account identifiers
# in the clear, whatever the configuration does to keep them out of the repo
tfplan
*.tfplan

# Build artefacts
site/public/audio/
build/

# Large media — belongs in S3, not git history
*.m4a
*.mp3
*.wav
*.pdf

# Python
__pycache__/
*.pyc

# Speech transform output — regenerated from content/
scripts/speech/

# Domain registrant PII — never commit
infra/domain-registration.json
