# Local environment for this project — template.
#
# Copy to a path OUTSIDE the repository, fill it in, and lock it down:
#
#   mkdir -p ~/.config/ice-hockey
#   cp infra/env.example ~/.config/ice-hockey/env
#   $EDITOR ~/.config/ice-hockey/env
#   chmod 600 ~/.config/ice-hockey/env
#
# Then, in a shell where you intend to work on this project:
#
#   source ~/.config/ice-hockey/env
#
# ---------------------------------------------------------------------------
# Why this exists rather than a file in the repo
#
# This repository is public and contains no AWS account id anywhere. The
# Terraform state bucket is named <project>-tfstate-<account-id>, because S3
# bucket names are globally unique, so writing it into backend.tf would put one
# in. Everything account-specific therefore lives here, outside the tree.
#
# It is also the whole backup story. Put this one file in your password vault
# and a new laptop needs nothing else from you: with it sourced, Terraform
# reads TF_VAR_* straight from the environment, so neither
# infra/terraform.tfvars nor infra/backend.hcl has to exist.
#
#   terraform init -backend-config="bucket=$ICE_HOCKEY_TF_STATE_BUCKET"
#   terraform plan
#
# Do NOT source this from ~/.zshrc. It exports AWS_PROFILE, and a shell that
# silently carries one is how the right plan reaches the wrong account —
# especially on a machine that also has credentials for an unrelated
# production account. Source it deliberately.
# ---------------------------------------------------------------------------

export AWS_PROFILE=CHANGEME

# --- Identifiers -----------------------------------------------------------

export ICE_HOCKEY_AWS_ACCOUNT_ID=CHANGEME
export ICE_HOCKEY_AWS_REGION=eu-west-2
export ICE_HOCKEY_DOMAIN=CHANGEME.example

# Printed by `terraform output` in infra/bootstrap after the one-off state apply.
export ICE_HOCKEY_TF_STATE_BUCKET=CHANGEME
export ICE_HOCKEY_TF_STATE_LOCK_TABLE=CHANGEME

# Printed by `terraform output` in infra/ after the main apply. Not read by
# Terraform; convenient for aws-cli one-liners.
export ICE_HOCKEY_SITE_BUCKET=CHANGEME
export ICE_HOCKEY_CLOUDFRONT_DISTRIBUTION_ID=CHANGEME

# --- Terraform inputs ------------------------------------------------------
#
# TF_VAR_<name> sets Terraform variable <name>. These mirror
# terraform.tfvars.example. Where both a tfvars file and one of these is set,
# the tfvars file wins.

export TF_VAR_domain_name="$ICE_HOCKEY_DOMAIN"
export TF_VAR_github_repository="CHANGEME/CHANGEME"
export TF_VAR_aws_region="$ICE_HOCKEY_AWS_REGION"
export TF_VAR_aws_profile="$AWS_PROFILE"
export TF_VAR_project_name="ice-hockey"
export TF_VAR_environment="production"

# JSON — a list and a map, not strings.
export TF_VAR_subject_alternative_names='["www.CHANGEME.example"]'
export TF_VAR_tags='{"Owner":"CHANGEME","CostCentre":"CHANGEME"}'

# false if a hosted zone for the domain already exists in the account, which is
# what registering the domain through Route 53 will have done. Creating a
# second zone leaves the registrar delegating to the first, and certificate
# validation then never completes.
export TF_VAR_create_route53_zone=false

# true only if `aws iam list-open-id-connect-providers` shows no provider for
# token.actions.githubusercontent.com. An account may hold one per URL.
export TF_VAR_create_oidc_provider=false
export TF_VAR_github_branch="main"

# Leave unset for the historic repo:<owner>/<repo> subject. Some accounts get
# an id-qualified subject instead, and a trust policy written the other way
# fails with a bare "Not authorized to perform sts:AssumeRoleWithWebIdentity".
# Ask GitHub rather than guessing:
#
#   gh api /repos/<owner>/<repo>/actions/oidc/customization/sub \
#     --jq .sub_claim_prefix
#
# export TF_VAR_github_oidc_subject_prefix="repo:owner@1234/repo@5678"

export TF_VAR_enable_logging=false
