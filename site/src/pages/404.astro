---
import Base from '../layouts/Base.astro';
import { LAYERS, READING_ORDER } from '../data/nav';

const first = READING_ORDER[0];
---

<Base title="Page not found" description="That page does not exist." bare={true}>
  <main class="main notfound" id="main">
    <h1>Page not found</h1>
    <p>
      There is no document at that address. It may have been renamed, or the link may have come
      from an older version of the corpus.
    </p>
    <div class="home-cta">
      <a class="button" href="/">All documents</a>
      <a class="button button--ghost" href="/search/">Search</a>
      <a class="button button--ghost" href={first.href}>{first.title}</a>
    </div>

    {/*
      Every other page on the site carries a <nav>: document pages get the full
      contents sidebar, the home page is itself the index. This page had neither
      — three buttons and nothing else — so a reader who arrived on a dead link
      had no way to see what the corpus contains without guessing at the two
      that pointed inward. The sections list is the same one the sidebar and the
      home page use.

      It links to the section hub pages rather than to the home page's anchors.
      This is the page a reader lands on after trimming a URL back a segment, and
      trimming `/systems/faceoffs/` to `/systems/` used to arrive here; sending
      them on to `/#systems` would have answered a request for the section with
      the top of a different page. The hubs exist now, so the heading "start from
      a section" can hand over an actual section.
    */}
    <nav class="notfound-nav" aria-label="Corpus sections">
      <p class="notfound-nav__heading">Or start from a section</p>
      <ul class="nav-list">
        {
          LAYERS.map((layer) => (
            <li>
              <a href={`/${layer.id}/`}>
                <span class="notfound-nav__title">{layer.title}</span>
                <span class="notfound-nav__tagline">{layer.tagline}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </main>
</Base>
