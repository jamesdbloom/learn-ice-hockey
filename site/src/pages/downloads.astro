---
import Base from '../layouts/Base.astro';
import { LAYERS, DOC_COUNT } from '../data/nav';
import podcast from '../data/podcast.json';
import { AUDIO_ENABLED } from '../consts';

// The audio episodes, grouped by section, in the corpus's reading order.
// Sizes and durations are MEASURED, from scripts/build_podcast_audio.py reading
// the encoded files — never estimated. A reader on mobile data should see "28 MB"
// before they tap, which is the same reason build-downloads.mjs carries byte sizes.
const episodes = [...podcast.episodes].sort((a, b) => a.track - b.track);
const audioHours = episodes.reduce((n, e) => n + e.duration_s, 0) / 3600;
const audioGb = episodes.reduce((n, e) => n + e.bytes, 0) / 1e9;
const mb = (bytes: number) => `${Math.round(bytes / 1e6)} MB`;
const mins = (s: number) => `${Math.round(s / 60)} min`;

// Filenames are deterministic and mirror scripts/build-downloads.mjs. That
// script runs *after* Astro (it reads the rendered HTML), so this page cannot
// import its manifest — hence the shared convention rather than a shared file.
// dist/downloads/manifest.json carries the byte sizes for anything that wants
// them; the check-links pass proves these hrefs resolve.
const epubs = [
  { file: 'learn-ice-hockey.epub', title: 'The complete corpus', note: `All ${DOC_COUNT} documents, in reading order.` },
  ...LAYERS.map((l) => ({ file: `${l.id}.epub`, title: l.title, note: l.tagline ?? '' })),
];
---

{/* bare: a standalone page with no sidebar and no table of contents, so the
    shell is a single block column — same as index.astro and 404.astro. */}
<Base
  title="Downloads"
  description="Take the corpus with you — EPUB for offline reading, and the markdown source."
  bare={true}
>
  <main class="main" id="main">
    <article>
      <h1>Downloads</h1>

      <h2>EPUB — for reading offline</h2>
      <p>
        The best format for reading on a phone: it reflows to your screen and font
        size, and works in Apple Books, Google Play Books, KOReader and most e-readers.
        Cross-references between documents stay inside the file, so the links still
        work with no signal.
      </p>

      <ul class="download-list">
        {epubs.map((e) => (
          <li>
            <a href={`/downloads/${e.file}`} download>{e.title}</a>
            {e.note && <span class="download-note"> — {e.note}</span>}
          </li>
        ))}
      </ul>

      <h2>PDF — for printing</h2>
      <p>
        Fixed layout, printed from the same stylesheet your browser uses for
        Cmd-P. Good for paper and for reading on a large screen; poor on a phone,
        where the EPUB above is the better answer. The complete corpus runs to
        over twelve hundred pages, so the per-section files are usually what you
        want.
      </p>

      <ul class="download-list">
        {epubs.map((e) => (
          <li>
            <a href={`/downloads/${e.file.replace('.epub', '.pdf')}`} download>{e.title}</a>
            {e.note && <span class="download-note"> — {e.note}</span>}
          </li>
        ))}
      </ul>

      <h2>Markdown — the source</h2>
      <p>
        The documents exactly as they are written and reviewed, one file each.
        This is the truth the site and every other format are generated from. The
        whole repository is public if you would rather clone it:{' '}
        <a href="https://github.com/jamesdbloom/learn-ice-hockey">jamesdbloom/learn-ice-hockey</a>.
      </p>
      <p>
        <a href="/downloads/manifest.json">manifest.json</a> lists every generated
        file with its size.
      </p>

      <h2>Audio</h2>

      {/* ⚠️ GATED ON THE SAME FLAG AS THE PLAYER, AND FOR THE SAME REASON.
          The player was disabled because all 37 episode URLs 404 until
          scripts/upload_podcast_audio.sh has run, and a control that looks healthy
          and does nothing is a misleading affordance. ⚠️ That reasoning was applied
          to the player and NOT to this page, which went on offering 46 links to the
          same missing files — while the honest "specified but parked" disclosure
          that used to stand here had been deleted in the same change, and
          check-links.mjs had just been taught to skip /audio/ so nothing mechanical
          would ever say so. A commit gate caught it.
          ONE FLAG, ONE TRUTH: when the audio is in the bucket, consts.ts flips and
          the whole feature — player, downloads, playlists, feed — becomes true at
          once. */}
      {!AUDIO_ENABLED && (
        <p>
          <strong>Not published yet.</strong> The {episodes.length} episodes are
          recorded and encoded &mdash; about {audioHours.toFixed(0)} hours, one per
          document &mdash; but they are not on the server yet, so there is nothing here
          to download. A podcast feed, per-section playlists and direct downloads are
          all ready and waiting on that upload. It is not abandoned.
        </p>
      )}

      {AUDIO_ENABLED && (
        <Fragment>
      <p>
        One episode per document, in reading order — {episodes.length} of them,
        about {audioHours.toFixed(0)} hours. They are spoken editions of the
        documents rather than word-for-word readings, so they are worth having
        alongside the text rather than instead of it. AAC in an <code>.m4a</code>
        container, mono, about {audioGb.toFixed(2)} GB for the lot.
      </p>

      <h3>Subscribe</h3>
      <p>
        <a href="/feed/podcast.xml">The podcast feed</a> works in Apple Podcasts,
        Overcast, Pocket Casts and anything else that reads RSS: copy that
        address into your app's &ldquo;add a show by URL&rdquo; box. Episodes are
        numbered rather than dated, so your app will play them in the order the
        corpus is meant to be read.
      </p>
      {/*
        The Spotify show, as a LINK and not an embed. The owner chose that trade on
        9 September 2026 with the cost measured rather than assumed — an embed is a
        third-party script, and this site's zero-off-origin-requests property is
        checked by review. A link costs nothing: nothing is fetched until a reader
        chooses to leave. See the same reasoning in AudioPlayer.astro.

        rel/target are set by hand here because the pipeline that adds them
        (rehype-corpus.mjs, "external links") only runs over markdown from
        content/, never over a page in src/pages.

        ⚠️ Registered in project/verification/link_baseline.tsv so link-check.yml
        notices if it dies. A dead "listen on Spotify" link is exactly the rot that
        file exists to catch. Apple Podcasts is NOT here yet — deliberately, because
        no show URL for it existed when this was written, and a guessed one would
        have been a fabricated citation. Add it beside Spotify when there is one.
      */}
      <p>
        {/*
          ⚠️ THE ANCHOR MUST STAY INLINE WITH THE WORDS EITHER SIDE OF IT. Written across
          several lines for readability, it rendered as "The show is onSpotifytoo" — the
          HTML compressor drops the whitespace-only tail of the preceding text node and the
          head of the following one, so nothing supplies the gap. It was the only place in
          the whole built site where prose was glued to a link. Do not fix that with a CSS
          margin; keep the tag inline, or use {' '}.
        */}
        The show is on <a class="external" href="https://open.spotify.com/show/6efEshtC6EDwLOVGuN1lKH" rel="noopener noreferrer" target="_blank">Spotify</a> too, which needs no feed
        address — follow that link, or search for it in the app.
      </p>

      <h3>Playlists</h3>
      <p>
        An <code>.m3u</code> playlist opens in VLC, Apple Music, most car stereos
        and almost any desktop player, and needs no account or app.
      </p>
      <ul class="download-list">
        <li>
          <a href="/audio/all.m3u" download>The complete corpus</a>
          <span class="download-note"> — all {episodes.length} episodes, in reading order.</span>
        </li>
        {LAYERS.map((l) => (
          <li>
            <a href={`/audio/${l.id}.m3u`} download>{l.title}</a>
            {l.tagline && <span class="download-note"> — {l.tagline}</span>}
          </li>
        ))}
      </ul>

      <h3>One episode at a time</h3>
      <p>
        Each document&rsquo;s own page carries its own player. The direct
        files are here if you would rather keep them &mdash; on a phone, saving
        one to Files lets you open it in an audiobook player such as BookPlayer.
      </p>
      <ul class="download-list">
        {episodes.map((e) => (
          <li>
            <a href={e.audio} download>{e.title}</a>
            <span class="download-note"> — {e.section} · {mins(e.duration_s)} · {mb(e.bytes)}</span>
          </li>
        ))}
      </ul>
        </Fragment>
      )}

      <hr />
      <p class="download-note">
        Not affiliated with the NHL, IIHF, USA Hockey, Hockey Canada, England Ice
        Hockey or any league. Rule quotations are the property of their governing
        bodies and are reproduced for study.
      </p>
    </article>
  </main>
</Base>

<style>
  .download-list { list-style: none; padding: 0; }
  .download-list li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .download-list a { font-weight: 600; }
  .download-note { color: var(--text-muted); font-size: 0.92em; }
</style>
