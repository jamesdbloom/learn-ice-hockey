---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import SidebarNav from '../components/SidebarNav.astro';
import TableOfContents from '../components/TableOfContents.astro';
import PrevNext from '../components/PrevNext.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import CiteThis from '../components/CiteThis.astro';
import { getDoc, getNeighbours } from '../data/nav';
import podcast from '../data/podcast.json';
import { AUDIO_ENABLED } from '../consts';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// The episode for this document, or undefined. A document with no episode renders
// no player at all — 38 pages were rendering one against 37 episodes, so the newest
// document offered a control that could never play.
const episode = podcast.episodes.find((e) => e.doc_id === entry.id);

const doc = getDoc(entry.id);
const { prev, next } = getNeighbours(entry.id);
---

<Base
  title={doc.title}
  description={doc.description}
  ogType="article"
  section={doc.layerTitle}
  withToc={true}
  {/* ⚠️ AUDIO_ENABLED, not `true`. `hasPlayer` raises `--player-h`, which
      `scroll-padding-top` adds — and AudioPlayer renders behind this same flag.
      Hardcoding `true` here made the two disagree the moment audio is switched
      off: every document page would keep the 128px padding with no player to
      justify it, putting 56px of dead space above every deep-linked heading —
      the exact over-correction global.css warns about. They must be one flag. */}
  hasPlayer={AUDIO_ENABLED}
>
  <main class="main" id="main">
    {/* ⚠️ BEFORE the article, not after it, and the reason is keyboard order.
        The player is `position: sticky; top: var(--header-h)` (global.css), so it is ON SCREEN
        from the first paint — but it used to sit after </article> in the DOM, which
        made it the 184th tab stop on breakouts and the 192nd on rules_primer, behind
        every inline link in the document. Measured in headless Chrome, not guessed.
        WCAG 2.4.3 asks that focus order match the order things are presented in.
        Moving it here costs nothing visually, because the positioning is sticky rather
        than static. ⚠️ If anyone makes this element non-sticky, revisit this: at that
        point DOM order and visual order agree again and it belongs back at the bottom.
        ⚠️ It is deliberately OUTSIDE <article data-pagefind-body> so the player's text
        never enters the search index. */}
    {episode && <AudioPlayer id={entry.id} title={doc.title} src={episode.audio} />}

    <article data-pagefind-body>
      <p class="doc-eyebrow">
        <a href={`/${doc.layerId}/`}>{doc.layerTitle}</a>
      </p>
      <h1 class="doc-title">{doc.title}</h1>

      <TableOfContents headings={headings} variant="inline" />

      <div class="prose">
        <Content />
      </div>

      <CiteThis title={doc.title} />
    </article>

    <PrevNext prev={prev} next={next} />
  </main>

  <SidebarNav currentId={entry.id} />
  <TableOfContents headings={headings} variant="aside" />
</Base>
