---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { VERSION_COMMENT } from '../lib/build-version.mjs';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  section?: string;
  /** Adds the third (table-of-contents) grid column. */
  withToc?: boolean;
  /** Renders the plain single-column shell used by the home and search pages. */
  bare?: boolean;
  /** ⚠️ True on pages that render the sticky AudioPlayer. It raises
   *  `--player-h`, which `scroll-padding-top` adds — without it a deep link
   *  lands its heading behind the player. Deliberately NOT inferred from
   *  `withToc`: those two happen to coincide today and nothing enforces it. */
  hasPlayer?: boolean;
  /** True when the player carries the two-format toggle. On a narrow screen that
   *  bar wraps to two rows, so `--player-h` must grow with it (global.css). */
  playerMulti?: boolean;
}

const {
  title,
  description,
  ogType,
  section,
  withToc = false,
  bare = false,
  hasPlayer = false,
  playerMulti = false,
} = Astro.props;
const htmlClass = hasPlayer ? (playerMulti ? 'has-player has-player--multi' : 'has-player') : undefined;
---

<!doctype html>
<html lang="en-GB" class={htmlClass}>
  <head>
    <Fragment set:html={`<!-- ${VERSION_COMMENT} -->`} />
    <BaseHead title={title} description={description} ogType={ogType} section={section} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <div class={bare ? 'shell shell--bare' : withToc ? 'shell shell--with-toc' : 'shell'}>
      <slot />
    </div>
    <Footer bare={bare} />
  </body>
</html>
