---
import { LAYERS } from '../data/nav';

interface Props {
  /** Collection id of the page currently being viewed, if any. */
  currentId?: string;
}

const { currentId } = Astro.props;
---

{/*
  Rendered after <main> in source order and moved into the left column by CSS
  grid on wide screens. That way narrow screens get the document first and the
  full contents list underneath it, with no JavaScript involved either way.
*/}
<nav class="sidebar" id="site-nav" aria-label="Corpus contents">
  {/*
    Nothing jumps here any more: the header's "Contents" button is a plain
    link to the home page on every page type. It used to point at #site-nav,
    and below 60rem — where the grid collapses and this nav is the last thing
    on the page — that tap threw the reader 98% of the way down a 100,765px
    document, measured on on_ice_communication at 375x812 on 10 September 2026,
    with nothing on screen to get back with. ⚠️ THAT FIGURE READ 65,000px UNTIL
    IT WAS RE-MEASURED AND FOUND 55% LOW — a page height is a property of a
    document that keeps growing, so it goes stale silently and no checker can
    see it. The 98% has held; the absolute number is the perishable half, which
    is why it now carries a date. This row was the way back. It stays because the
    trip is still available on foot: below 60rem a reader who scrolls to the
    contents has scrolled the whole document to reach it. Hidden on wide
    screens, where the rail is sticky and never has to be scrolled to.
  */}
  <div class="sidebar__top">
    <p class="sidebar__heading">Contents</p>
    <a class="sidebar__back" href="#main"><span aria-hidden="true">↑</span> Back to top</a>
  </div>
  {
    LAYERS.map((layer) => (
      <div class="nav-layer">
        {/*
          The section hub, not the home page's anchor for it. Every page carries
          this nav, so this is also what gives the eight hub pages an inbound
          internal link from all 45 of the others — a page nothing links to is a
          page a crawler has little reason to rank.
        */}
        <p class="nav-layer__title">
          <a href={`/${layer.id}/`}>{layer.title}</a>
        </p>
        <ul class="nav-list">
          {layer.docs.map((doc) => (
            <li>
              <a href={doc.href} aria-current={doc.id === currentId ? 'page' : undefined}>
                {doc.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</nav>
