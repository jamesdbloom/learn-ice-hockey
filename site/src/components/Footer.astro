---
import { NON_AFFILIATION } from '../consts';
import { DOC_COUNT } from '../data/nav';

interface Props {
  /**
   * Matches the footer's width to the shell above it. The bare shell (home and
   * search) is narrower than the document shell, which carries a sidebar and a
   * table of contents either side of the text. Without this the footer starts
   * further left than the content it sits under.
   */
  bare?: boolean;
}

const { bare = false } = Astro.props;
---

<footer class="site-footer">
  <div class:list={['site-footer__inner', bare && 'site-footer__inner--bare']}>
    <p>
      {DOC_COUNT} documents. Every one ends with Common Mistakes, Key Takeaways and a dated
      Sources section, and flags anything that could not be independently verified.
    </p>
    <p class="site-footer__links">
      <a href="/downloads/">Downloads</a> · <a href="/search/">Search</a> ·{' '}
      <a href="https://github.com/jamesdbloom/learn-ice-hockey">Source on GitHub</a>
    </p>
    <p>{NON_AFFILIATION}</p>
  </div>
</footer>
