---
import { AUDIO_ENABLED, AUDIO_BASE } from '../consts';

interface Props {
  /** Collection id, e.g. `faceoffs` or `positions/center`. */
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const src = `${AUDIO_BASE}/${id}.m4a`;
const storageKey = `audio-position:${id}`;
---

{/*
  Self-hosted, deliberately. The owner chose this over a Spotify embed on
  9 September 2026 once the cost was measured rather than assumed: a Spotify
  embed loads 15 scripts from six off-origin hosts and its <noscript> is empty,
  and the site currently makes ZERO off-origin requests. oEmbed does not avoid
  it — it hands you the same iframe. This element keeps that property, and
  degrades to a plain download link with scripting off.

  ⚠️ "Listen" and "Audio edition", never "Narration" — see the note in
  src/consts.ts. The episodes are not verbatim readings and the durations prove
  it, so a label promising narration would be a claim the audio cannot support.
*/}
{
  AUDIO_ENABLED && (
    <div class="audio-player" data-audio-player data-storage-key={storageKey}>
      <span class="audio-player__label">Listen</span>
      <audio controls preload="none" src={src} aria-label={`Audio edition of ${title}`}>
        <a href={src}>Download the audio edition of {title}</a>
      </audio>
    </div>
  )
}

{
  AUDIO_ENABLED && (
    <script is:inline src="/audio-player.js" defer></script>
  )
}
