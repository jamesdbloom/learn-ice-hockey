---
import { AUDIO_ENABLED } from '../consts';
import { minutes } from '../data/podcast';

export interface PlayerFormat {
  /** `conversation` or `principles` — see src/data/podcast.ts. */
  id: string;
  /** "Conversation" or "Playing principles". */
  label: string;
  /**
   * The episode's URL, from the format's manifest. REQUIRED, and deliberately not
   * derived from the document id.
   *
   * ⚠️ It used to be `${AUDIO_BASE}/${id}.m4a`, which held only while every
   * collection id matched its encoded filename. Renaming a document broke that
   * silently: the page offered `/audio/foundation/rink_map.m4a` while the file on
   * the origin, the feed, the m3u playlists and the downloads page all still said
   * `rink_map_and_glossary.m4a`. Nothing failed at build time — check-links.mjs
   * skips every /audio/ href on purpose, because the audio is uploaded out of band.
   * A reader found a dead player.
   *
   * Taking the URL from the manifest makes the manifest the single source of truth,
   * so the page cannot disagree with the feed.
   */
  src: string;
  durationS: number;
  /** localStorage key for the resume position. Conversation keeps the original
   *  `audio-position:<doc_id>` so nobody loses their place. */
  storageKey: string;
}

interface Props {
  /** Collection id, e.g. `faceoffs` or `positions/center`. */
  id: string;
  title: string;
  /** One entry per format that exists for this document, Conversation first. */
  formats: PlayerFormat[];
}

const { id, title, formats } = Astro.props;
const [first] = formats;
const multi = formats.length > 1;
const optionText = (f: PlayerFormat) => `${f.label} · ${minutes(f.durationS)} min`;
---

{/*
  Self-hosted, deliberately. The owner chose this over a Spotify embed on
  9 September 2026 once the cost was measured rather than assumed: a Spotify
  embed loads 15 scripts from six off-origin hosts and its <noscript> is empty,
  and apart from the production Google Analytics tag (injected only when
  PUBLIC_GA_ID is set at build; local builds make none) the site makes no
  off-origin requests. oEmbed does not avoid
  it — it hands you the same iframe. This element keeps that property, and
  degrades to a plain download link with scripting off.

  ⚠️ "Listen", never "Narration", "narrated" or "read aloud" — see the note in
  src/consts.ts. The episodes are not verbatim readings and the durations prove
  it (a 17x apparent-wpm spread), so a label promising narration would be a claim
  the audio cannot support.

  ⚠️ AND NOT "the audio edition" EITHER. The owner rejected that wording on
  9 September 2026: "the audio should also stand alone on its own as a separate
  standalone podcast, not be too strongly stated as just an audio version of the
  site." Both "narration" and "audio edition" describe the episode by its
  RELATIONSHIP TO THE SITE rather than by its subject.
  ⚠️ `scripts/build_podcast_audio.py:37` was corrected for this on the day, and
  THIS COMPONENT WAS NOT — it kept shipping "Audio edition of {title}" in the
  aria-label while telling the next editor to use it. The correction reached the
  podcast metadata and stopped, which is this corpus's signature defect.
*/}
{/*
  TWO FORMATS, ONE BAR (owner, 16 October 2026; project/podcast_two_formats.md).
  Each document can have a Conversation and a Playing principles episode. With two,
  a radio group picks which <audio> is shown, and the switch is pure CSS (`:has()` in
  global.css) — ⚠️ NOT an inline handler: the production CSP is `script-src 'self'`,
  so an inline script works locally and silently dies in production.
  audio-player.js only ADDS to this: per-format resume, pausing the other element,
  remembering the choice, and hiding one option whose file fails.
  With one format the bar is as it always was, labelled with the format's name.
  ⚠️ Without `:has()` support both players show. That is a degraded layout, not a
  broken one, and every control still works.
*/}
{
  AUDIO_ENABLED && first && (
    <div
      class={multi ? 'audio-player audio-player--multi' : 'audio-player'}
      data-audio-player
      data-doc-id={id}
    >
      {multi ? (
        <fieldset class="audio-player__formats">
          <legend class="visually-hidden">Choose an episode format</legend>
          {formats.map((f, i) => (
            <label class="audio-player__option" data-format-option={f.id}>
              <input type="radio" name="audio-format" value={f.id} checked={i === 0} />
              <span>{optionText(f)}</span>
            </label>
          ))}
        </fieldset>
      ) : (
        <span class="audio-player__label">{optionText(first)}</span>
      )}
      {formats.map((f) => (
        <div class="audio-player__track" data-format={f.id}>
          <audio
            controls
            preload="none"
            src={f.src}
            data-storage-key={f.storageKey}
            aria-label={`Listen to ${title}: ${f.label}`}
          >
            <a href={f.src}>Download the {title} {f.label} episode</a>
          </audio>
        </div>
      ))}
    </div>
  )
}

{
  AUDIO_ENABLED && (
    <script is:inline src="/audio-player.js" defer></script>
  )
}
