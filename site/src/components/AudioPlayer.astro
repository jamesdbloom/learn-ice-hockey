---
import { AUDIO_ENABLED, AUDIO_BASE } from '../consts';

interface Props {
  /** Collection id, e.g. `faceoffs` or `positions/center`. */
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const src = `${AUDIO_BASE}/${id}.mp3`;
const storageKey = `audio-position:${id}`;
---

{/*
  The narration does not exist yet (build spec phases 4–5), so the whole player
  is behind AUDIO_ENABLED in src/consts.ts and is off by default. The shell is
  built and styled so that turning the flag on is the only change needed.
*/}
{
  AUDIO_ENABLED && (
    <div class="audio-player" data-audio-player data-storage-key={storageKey}>
      <span class="audio-player__label">Listen</span>
      <audio controls preload="none" src={src} aria-label={`Narration of ${title}`}>
        <a href={src}>Download the narration of {title}</a>
      </audio>
    </div>
  )
}

{
  AUDIO_ENABLED && (
    <script is:inline src="/audio-player.js" defer></script>
  )
}
