---
import {
  SITE_TITLE, SITE_SHORT_TITLE, SITE_DESCRIPTION, SITE_AUTHOR, SITE_AUTHOR_URL,
  GA_MEASUREMENT_ID, GOOGLE_SITE_VERIFICATION,
} from '../consts';
import { LAYERS } from '../data/nav';
import ogManifest from '../data/og.json';

interface Props {
  title?: string;
  description?: string;
  /** "article" for documents, "website" for index pages. */
  ogType?: 'website' | 'article';
  /** Section shown in Open Graph metadata (the corpus layer). */
  section?: string;
}

const { title, description, ogType = 'website', section } = Astro.props;

const pageTitle = title ? `${title} — ${SITE_SHORT_TITLE}` : SITE_TITLE;
const pageDescription = description ?? SITE_DESCRIPTION;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const siteBase = (Astro.site ?? new URL('/', Astro.url)).href.replace(/\/$/, '');

/*
  Structured data. Search engines were finding this site's pages and indexing
  them, but nothing on the page said what kind of thing a page *is* — so a
  36-document teaching corpus was indistinguishable from a blog. Bing in
  particular leans on explicit markup rather than inferring it.

  Two graphs only, both derivable from props that already exist. Nothing is
  invented: `headline` and `description` are the same strings already in the
  title and meta description, `author` and `license` already appear as tags
  above, and the breadcrumb trail is read off the URL path rather than from a
  hand-kept list that could drift out of step with the routes.

  No `datePublished`. The layout does not carry document dates, and a fabricated
  one is worse than an absent one — Google treats a date it can see as a claim.
*/
/*
  The trail is Home → Section → document.

  The rule this file has always enforced is unchanged: only emit a crumb for a
  URL that is actually built. What changed is which URLs are built. An earlier
  version walked the whole path and emitted a crumb per segment, which told
  search engines that eight section pages existed when every one of them
  returned the 404; it was cut back to Home → document for that reason.
  `src/pages/[layer]/index.astro` now builds all eight, so the middle crumb is
  true and is emitted again — but it is emitted from the layer list rather than
  from the path string, so a segment that is not a real section still gets no
  crumb. `/search/` and `/downloads/` are one-segment pages that are not
  sections, and they take the leaf branch as before.

  `check-links.mjs` reads `<a href>` and not JSON-LD, so it cannot catch a
  regression here. The guard is that `LAYERS` is the same list the routes are
  generated from: a crumb can only be emitted for a section that exists,
  because the crumb and the page come from one source.
*/
const crumbs = Astro.url.pathname.split('/').filter(Boolean);
const layerTitles = new Map(LAYERS.map((l) => [l.id, l.title]));
// The 404 page is built as `404.html` and served by CloudFront on error. There
// is no `/404/` URL, so it gets Home and nothing else.
const isError = !crumbs.length || crumbs[crumbs.length - 1] === '404';
// A section crumb only when the first segment names a built section *and* the
// page is not that section itself — a hub must not list itself twice.
const sectionId = crumbs.length > 1 && layerTitles.has(crumbs[0]) ? crumbs[0] : null;
const section_crumb = sectionId
  ? [{ name: layerTitles.get(sectionId)!, item: `${siteBase}/${sectionId}/` }]
  : [];
const leaf = isError
  ? []
  : [{
      name: title ?? crumbs[crumbs.length - 1].replace(/[-_]/g, ' '),
      item: canonical,
    }];
const breadcrumb = [
  { name: 'Home', item: `${siteBase}/` },
  ...section_crumb,
  ...leaf,
].map((c, i) => ({
  '@type': 'ListItem',
  position: i + 1,
  name: c.name,
  item: c.item,
}));

/*
  Open Graph image. Rendered at 1200x630 by scripts/build-og.mjs and looked up
  by pathname, so a page only claims a card that was actually written to disk —
  if the manifest is empty (no Chrome at build time) nothing is emitted and the
  share falls back to the text preview this site had before.

  Absolute URLs, because Open Graph consumers do not resolve relative ones.
*/
const og = (ogManifest as Record<string, { image: string; width: number; height: number; alt: string }>)[
  Astro.url.pathname
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ogType === 'article' ? 'Article' : 'WebSite',
      '@id': canonical,
      url: canonical,
      name: pageTitle,
      headline: title ?? SITE_TITLE,
      description: pageDescription,
      inLanguage: 'en-GB',
      isAccessibleForFree: true,
      license: 'https://creativecommons.org/licenses/by-nc/4.0/',
      author: { '@type': 'Person', name: SITE_AUTHOR, url: SITE_AUTHOR_URL },
      publisher: { '@type': 'Person', name: SITE_AUTHOR, url: SITE_AUTHOR_URL },
      ...(section ? { articleSection: section } : {}),
      // Only on a document. On the home page the WebSite node *is* the site,
      // and `isPartOf` pointing at its own @id asserts that it contains itself.
      ...(canonical === `${siteBase}/`
        ? {}
        : { isPartOf: { '@type': 'WebSite', '@id': `${siteBase}/`, name: SITE_TITLE, url: `${siteBase}/` } }),
    },
    { '@type': 'BreadcrumbList', itemListElement: breadcrumb },
  ],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content={ogType} />
<meta property="og:title" content={title ?? SITE_TITLE} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE_TITLE} />
{section && <meta property="article:section" content={section} />}

{og && (
  <>
    <meta property="og:image" content={`${siteBase}${og.image}`} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={og.alt} />
    <meta property="og:image:type" content="image/png" />
  </>
)}

{/*
  `summary_large_image` only where there is a large image to show. Declaring it
  with no og:image is how a share renders as an empty box rather than falling
  back to the small card.
*/}
<meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title ?? SITE_TITLE} />
<meta name="twitter:description" content={pageDescription} />
{og && <meta name="twitter:image" content={`${siteBase}${og.image}`} />}
{og && <meta name="twitter:image:alt" content={og.alt} />}

<meta name="author" content={SITE_AUTHOR} />
{GOOGLE_SITE_VERIFICATION && (
  <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
)}
<link rel="license" href="https://creativecommons.org/licenses/by-nc/4.0/" />
<meta name="color-scheme" content="light dark" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<!--
  Installable web app (D9). iOS does not read most of the manifest, so the
  apple-* tags are not redundant with it — without them an installed home-screen
  icon on iPhone is a screenshot of the page rather than the icon.
-->
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" content="#0f5a8f" />
<link rel="apple-touch-icon" href="/icons/icon-192.png" />
{/*
  Both capability tags, deliberately.

  A JSX comment rather than an HTML one so it stays out of the shipped markup:
  it is long, it appears on all 42 pages, and it quotes two meta tags verbatim,
  which makes a grep of dist/ report capability tags that are not really there.

  Chrome logged the only console warning on any page of this site: the
  apple-mobile-web-app-capable tag is deprecated, "Please include
  <meta name=mobile-web-app-capable content=yes>". Note what it asks for — that
  the standard tag be *included*, not that the Apple one be removed. So the
  standard tag is added here and the Apple one stays.

  Removing the Apple tag was considered and rejected on the evidence available.
  What was checked when this was written: WebKit's "New WebKit Features in
  Safari 15.4" post describes Web App Manifest improvements (manifest fetched
  during page load, icons declared in the manifest now supported) but says
  nothing about the manifest's `display` member, which is what would have to be
  honoured for the manifest alone to launch standalone on iOS; and web.dev's web
  app manifest page advises against the legacy meta elements without naming any
  iOS version from which they stopped being needed. Neither source establishes
  that iOS reads the standard tag. Not established, so not removed — dropping it
  would silently downgrade older iPhones from a standalone home-screen app to a
  Safari tab, and the warning does not ask for that.
*/}
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="Ice Hockey" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

<!--
  Applied before first paint so a stored theme preference does not flash.
  Everything on this site is readable without JavaScript; this only chooses
  between two colour schemes.
-->
<script is:inline src="/theme-init.js"></script>

<!--
  Service worker registration. Deferred to the load event so it never competes
  with first paint — the site is fully readable without it, and an installed
  reader gains offline access rather than losing anything if this fails.

  The worker itself is generated at build time by scripts/build-pwa.mjs, because
  its precache list has to name the content-hashed stylesheet.
-->
<script is:inline src="/sw-register.js" defer></script>

{/*
  Google Analytics 4. Emitted only when GA_MEASUREMENT_ID is set, so local
  builds, previews and anyone building from a clone send nothing.

  The bootstrap deliberately does NOT use define:vars, which would force an
  inline script. The production CSP is script-src 'self' with no unsafe-inline
  (infra/locals.tf), and adding that exemption to run four lines of setup would
  weaken the policy for every page. Instead the id travels on a meta tag and the
  bootstrap is a normal Astro script, bundled and served from our own origin.
  Only gtag.js itself is off-origin, and the CSP names that host explicitly.
*/}
{
  GA_MEASUREMENT_ID && (
    <>
      <meta name="ga-measurement-id" content={GA_MEASUREMENT_ID} />
      <link rel="preconnect" href="https://www.googletagmanager.com" />
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
      />
      <script is:inline src="/analytics.js" defer></script>
    </>
  )
}
