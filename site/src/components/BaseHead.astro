---
import {
  SITE_TITLE, SITE_SHORT_TITLE, SITE_DESCRIPTION, SITE_AUTHOR,
  GA_MEASUREMENT_ID, GOOGLE_SITE_VERIFICATION,
} from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** "article" for documents, "website" for index pages. */
  ogType?: 'website' | 'article';
  /** Section shown in Open Graph metadata (the corpus layer). */
  section?: string;
}

const { title, description, ogType = 'website', section } = Astro.props;

const pageTitle = title ? `${title} — ${SITE_SHORT_TITLE}` : SITE_TITLE;
const pageDescription = description ?? SITE_DESCRIPTION;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content={ogType} />
<meta property="og:title" content={title ?? SITE_TITLE} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE_TITLE} />
{section && <meta property="article:section" content={section} />}

<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title ?? SITE_TITLE} />
<meta name="twitter:description" content={pageDescription} />

<meta name="author" content={SITE_AUTHOR} />
{GOOGLE_SITE_VERIFICATION && (
  <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
)}
<link rel="license" href="https://creativecommons.org/licenses/by-nc/4.0/" />
<meta name="color-scheme" content="light dark" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap.xml" />

<!--
  Installable web app (D9). iOS does not read most of the manifest, so the
  apple-* tags are not redundant with it — without them an installed home-screen
  icon on iPhone is a screenshot of the page rather than the icon.
-->
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" content="#0f5a8f" />
<link rel="apple-touch-icon" href="/icons/icon-192.png" />
{/*
  Both capability tags, deliberately.

  A JSX comment rather than an HTML one so it stays out of the shipped markup:
  it is long, it appears on all 42 pages, and it quotes two meta tags verbatim,
  which makes a grep of dist/ report capability tags that are not really there.

  Chrome logged the only console warning on any page of this site: the
  apple-mobile-web-app-capable tag is deprecated, "Please include
  <meta name=mobile-web-app-capable content=yes>". Note what it asks for — that
  the standard tag be *included*, not that the Apple one be removed. So the
  standard tag is added here and the Apple one stays.

  Removing the Apple tag was considered and rejected on the evidence available.
  What was checked when this was written: WebKit's "New WebKit Features in
  Safari 15.4" post describes Web App Manifest improvements (manifest fetched
  during page load, icons declared in the manifest now supported) but says
  nothing about the manifest's `display` member, which is what would have to be
  honoured for the manifest alone to launch standalone on iOS; and web.dev's web
  app manifest page advises against the legacy meta elements without naming any
  iOS version from which they stopped being needed. Neither source establishes
  that iOS reads the standard tag. Not established, so not removed — dropping it
  would silently downgrade older iPhones from a standalone home-screen app to a
  Safari tab, and the warning does not ask for that.
*/}
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="Ice Hockey" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

<!--
  Applied before first paint so a stored theme preference does not flash.
  Everything on this site is readable without JavaScript; this only chooses
  between two colour schemes.
-->
<script is:inline src="/theme-init.js"></script>

<!--
  Service worker registration. Deferred to the load event so it never competes
  with first paint — the site is fully readable without it, and an installed
  reader gains offline access rather than losing anything if this fails.

  The worker itself is generated at build time by scripts/build-pwa.mjs, because
  its precache list has to name the content-hashed stylesheet.
-->
<script is:inline src="/sw-register.js" defer></script>

{/*
  Google Analytics 4. Emitted only when GA_MEASUREMENT_ID is set, so local
  builds, previews and anyone building from a clone send nothing.

  The bootstrap deliberately does NOT use define:vars, which would force an
  inline script. The production CSP is script-src 'self' with no unsafe-inline
  (infra/locals.tf), and adding that exemption to run four lines of setup would
  weaken the policy for every page. Instead the id travels on a meta tag and the
  bootstrap is a normal Astro script, bundled and served from our own origin.
  Only gtag.js itself is off-origin, and the CSP names that host explicitly.
*/}
{
  GA_MEASUREMENT_ID && (
    <>
      <meta name="ga-measurement-id" content={GA_MEASUREMENT_ID} />
      <link rel="preconnect" href="https://www.googletagmanager.com" />
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
      />
      <script is:inline src="/analytics.js" defer></script>
    </>
  )
}
