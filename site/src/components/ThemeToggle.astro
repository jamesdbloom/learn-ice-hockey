---
/**
 * Light/dark toggle. Purely additive — `prefers-color-scheme` already gives a
 * correct theme with JavaScript disabled, so the control is only rendered for
 * clients that can act on it.
 */
---

<button
  id="theme-toggle"
  class="icon-button"
  type="button"
  hidden
  aria-live="polite"
  aria-label="Switch colour theme"
>
  <span aria-hidden="true" id="theme-toggle-icon">◐</span>
  <span class="visually-hidden" id="theme-toggle-text">Switch colour theme</span>
</button>

<script is:inline src="/theme-toggle.js" defer></script>
