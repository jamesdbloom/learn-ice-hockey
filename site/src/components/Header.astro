---
import ThemeToggle from './ThemeToggle.astro';
import { SITE_SHORT_TITLE } from '../consts';

interface Props {
  /** Where the "Contents" shortcut points. Document pages have an in-page nav. */
  navHref?: string;
}

const { navHref = '/' } = Astro.props;
---

<header class="site-header">
  <a class="site-header__brand" href="/">
    <span class="puck" aria-hidden="true"></span>
    <span>{SITE_SHORT_TITLE}</span>
  </a>
  <span class="site-header__spacer"></span>
  <div class="site-header__actions">
    <a class="icon-button" href={navHref}>Contents</a>
    <a class="icon-button" href="/search/" rel="search">
      <span aria-hidden="true">⌕</span>
      <span>Search</span>
    </a>
    <ThemeToggle />
  </div>
</header>

<script is:inline src="/header.js" defer></script>
